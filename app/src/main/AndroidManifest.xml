<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Contact tiles call directly after a spoken confirm. If refused, the dialer opens instead. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- The See tile: the camera as a magnifier. Asked for only when See is opened. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Touch landmarks: vibration patterns that say where a tile is. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Resetting a forgotten helper PIN with the phone's own screen lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Texts. Android grants these only to the phone's texting app, and only once the person
         makes RP Launcher that app in Setup. Nothing here is used before then. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Names instead of numbers in Texts. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- This phone's own number, so it's left out of group texts. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <!-- New texts, and texts that didn't go through. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice messages. Asked for only when the person records one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phone. Android grants call history only to the phone app, once the person makes
         RP Launcher that app in Setup. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- The call screen over the lock screen, and the screen off at the ear during calls. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- SOS and Where am I: the phone's location, only while those screens are open. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The Notifications and Quick settings tiles pull down the phone's drop-down. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- A launcher sees other apps through <queries>, not QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Which app is the phone's texting app, to name it. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Voice replies: the phone's speech recogniser. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Playing clips and videos, and opening other files, in the phone's own apps. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".RpApp"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RpLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads new notifications for the Alerts tile, once the person turns on access.
             Kept in memory only; never saved or sent anywhere. -->
        <service
            android:name=".system.RpNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ===== Texts: what Android requires of the phone's texting app ===== -->

        <!-- New texts. -->
        <receiver
            android:name=".texts.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- "A picture text is waiting" and picture text delivery reports. -->
        <receiver
            android:name=".texts.MmsPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Results of sending and downloading. Only the phone itself can reach this. -->
        <receiver
            android:name=".texts.TextResultReceiver"
            android:exported="false" />

        <!-- Quick replies when declining a call. -->
        <service
            android:name=".texts.QuickReplyService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- "Text this person" and "share to Texts" from other apps. -->
        <activity
            android:name=".texts.ComposeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
            </intent-filter>
        </activity>

        <!-- ===== Phone: what Android requires of the phone app ===== -->

        <!-- The call screen. Android binds this for every call while RP Launcher is the phone app. -->
        <service
            android:name=".calls.RpInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <activity
            android:name=".calls.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.netgician.rplauncher.call"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.RpLauncher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale" />

        <!-- "Add to home screen" from other apps (a web page in Chrome, say): asks, then adds a tile. -->
        <activity
            android:name=".ui.PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.netgician.rplauncher.pin"
            android:theme="@style/Theme.RpLauncher">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!-- The keypad, for "call this number" from other apps. -->
        <activity
            android:name=".calls.DialActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Picture texts going to and from the carrier, and attachments opened in other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
