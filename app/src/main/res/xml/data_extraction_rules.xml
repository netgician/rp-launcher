<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rule, for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="config.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="config.xml" />
    </device-transfer>
</data-extraction-rules>
